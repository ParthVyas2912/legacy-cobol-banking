{
  "ConnectionStrings": {
    "DefaultConnection": "Host=your_server_address;Database=your_database_name;Username=your_database_username;Password=your_database_password;",
    "RedisConnection": "server_address:6379,password=your_redis_password,ssl=True,abortConnect=False"
  },
  "Jwt": {
    "Key": "ReplaceThisWithAStrongSecretKey",
    "Issuer": "YourIssuer",
    "Audience": "YourAudience",
    "TokenExpiryInMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}