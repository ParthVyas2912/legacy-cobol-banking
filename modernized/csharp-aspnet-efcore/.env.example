# Environment Configuration Example File

# PostgreSQL Connection
DATABASE_URL=Host=your_server_address;Database=your_database_name;Username=your_database_username;Password=your_database_password;

# Redis Cache Configuration
REDIS_CONNECTION=server_address:6379,password=your_redis_password,ssl=True,abortConnect=False

# JWT Configuration
JWT_KEY=ReplaceThisWithAStrongSecretKey
JWT_ISSUER=YourIssuer
JWT_AUDIENCE=YourAudience
JWT_TOKEN_EXPIRY=60