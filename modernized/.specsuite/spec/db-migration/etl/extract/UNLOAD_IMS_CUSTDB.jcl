//IMSCUSTJOB (ACCT,MIGR),'IMS EXTRACT',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*
//* MainframeForge — Full unload of IMS database CUSTDB
//* Access method: HIDAM
//* Segments: CUSTOMER, ACCTLNK, ADDRESS
//*
//* NOTE: Adjust DFSRESLB, IMS libraries, and PSB name to match your site.
//*
//STEP010  EXEC PGM=DFSRRC00,
//             PARM='ULU,DFSURGL0,CUSTDBPSB'
//STEPLIB  DD  DSN=IMS.SDFSRESL,DISP=SHR
//DFSRESLB DD  DSN=IMS.SDFSRESL,DISP=SHR
//IMS      DD  DSN=IMS.PSBLIB,DISP=SHR
//         DD  DSN=IMS.DBDLIB,DISP=SHR
//CUSTDB   DD  DSN=IMS.CUSTDB,DISP=SHR
//SYSPRINT DD  SYSOUT=*
//DFSURCDS DD  DSN=MIGR.UNLOAD.IMS.CUSTDB.UNLOAD,
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(CYL,(200,100)),
//             DCB=(RECFM=VB,LRECL=32756,BLKSIZE=32760)
//SYSUDUMP DD  SYSOUT=*
//