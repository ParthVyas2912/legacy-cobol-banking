//AUDITVSAJOB (ACCT,MIGR),'DATA EXTRACT',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*
//* MainframeForge — Extract AUDITVSAM (VSAM KSDS) to flat file
//*
//STEP010  EXEC PGM=IDCAMS
//SYSPRINT DD  SYSOUT=*
//INPUT    DD  DSN=MIGR.UNLOAD.AUDITVSAM,DISP=SHR
//OUTPUT   DD  DSN=MIGR.UNLOAD.AUDITVSAM.UNLOAD,
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,
//             SPACE=(CYL,(100,50)),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=20000)
//SYSIN    DD  *
  REPRO -
    INFILE(INPUT) -
    OUTFILE(OUTPUT)
/*
//