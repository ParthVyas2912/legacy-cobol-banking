ATMMSET  DFHMSD TYPE=&SYSPARM,                                         X
               MODE=INOUT,                                             X
               LANG=COBOL,                                             X
               STORAGE=AUTO,                                           X
               TIOAPFX=YES,                                            X
               CTRL=(FREEKB,FRSET)
ATMMAIN  DFHMDI SIZE=(24,80),                                          X
               LINE=1,                                                 X
               COLUMN=1
TITLE    DFHMDF POS=(1,30),                                            X
               LENGTH=20,                                              X
               INITIAL='ATM TRANSACTION ENTRY',                        X
               ATTRB=(PROT,BRT)
ACCTLBL  DFHMDF POS=(3,5),                                             X
               LENGTH=15,                                              X
               INITIAL='ACCOUNT NUMBER:',                              X
               ATTRB=(PROT,NORM)
ACCTNO   DFHMDF POS=(3,25),                                            X
               LENGTH=10,                                              X
               ATTRB=(UNPROT,NUM,IC,FSET)
AMTLBL   DFHMDF POS=(5,5),                                             X
               LENGTH=15,                                              X
               INITIAL='AMOUNT:',                                      X
               ATTRB=(PROT,NORM)
AMTIN    DFHMDF POS=(5,25),                                            X
               LENGTH=12,                                              X
               ATTRB=(UNPROT,NUM,FSET)
MSGOUT   DFHMDF POS=(22,5),                                            X
               LENGTH=60,                                              X
               ATTRB=(PROT,BRT)
ATMNEXT  DFHMDI SIZE=(24,80),                                          X
               LINE=1,                                                 X
               COLUMN=1
HEADER   DFHMDF POS=(1,28),                                            X
               LENGTH=24,                                              X
               INITIAL='TRANSACTION CONFIRMATION',                     X
               ATTRB=(PROT,BRT)
RESULT   DFHMDF POS=(5,5),                                             X
               LENGTH=60,                                              X
               ATTRB=(PROT,NORM)
         DFHMSD TYPE=FINAL
         END
