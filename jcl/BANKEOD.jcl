//BANKEOD  JOB (ACCT,BANK),'EOD BATCH',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//*
//*  End-of-day banking batch — drives interest accrual then posts
//*  all queued transactions via the BCHEOD program.
//*
//JOBLIB   DD  DSN=BANK.PROD.LOADLIB,DISP=SHR
//*
//STEP010  EXEC PGM=BCHEOD,COND=(0,NE)
//ACCTFILE DD  DSN=BANK.PROD.ACCT,DISP=SHR
//TXNIN    DD  DSN=BANK.DAILY.TXN.QUEUE,DISP=(OLD,DELETE,KEEP)
//INTJRNL  DD  DSN=&&INTJRNL,DISP=(NEW,PASS),
//             UNIT=SYSDA,SPACE=(CYL,(10,5)),
//             DCB=(RECFM=FB,LRECL=180,BLKSIZE=18000)
//AUDITOUT DD  DSN=BANK.DAILY.AUDIT,DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(5,2)),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=20000)
//SYSOUT   DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//*
//STEP020  EXEC PGM=STMTRPT,COND=(0,NE,STEP010)
//STMTOUT  DD  DSN=BANK.DAILY.STMT,DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(5,2)),
//             DCB=(RECFM=FB,LRECL=120,BLKSIZE=12000)
//SYSOUT   DD  SYSOUT=*
//
