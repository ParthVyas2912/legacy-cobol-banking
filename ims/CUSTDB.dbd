         PRINT NOGEN
CUSTDB   DBD   NAME=CUSTDB,ACCESS=(HIDAM,VSAM)
         DATASET DD1=CUSTDB,DEVICE=3390,BLOCK=8192
*
CUSTOMER SEGM  NAME=CUSTOMER,PARENT=0,BYTES=200,FREQ=10000
         FIELD NAME=(CUSTID,SEQ,U),BYTES=8,START=1,TYPE=C
         FIELD NAME=LASTNAME,BYTES=30,START=9,TYPE=C
         FIELD NAME=FIRSTNAME,BYTES=20,START=39,TYPE=C
         FIELD NAME=TAXID,BYTES=9,START=59,TYPE=C
         FIELD NAME=KYCSTAT,BYTES=1,START=68,TYPE=C
         FIELD NAME=RISKSCR,BYTES=2,START=69,TYPE=P
*
ACCTLNK  SEGM  NAME=ACCTLNK,PARENT=CUSTOMER,BYTES=20,FREQ=5
         FIELD NAME=(ACCTNUM,SEQ,U),BYTES=10,START=1,TYPE=C
         FIELD NAME=ROLE,BYTES=2,START=11,TYPE=C
*
ADDRESS  SEGM  NAME=ADDRESS,PARENT=CUSTOMER,BYTES=120,FREQ=2
         FIELD NAME=(EFFDATE,SEQ,U),BYTES=8,START=1,TYPE=C
         FIELD NAME=STREET,BYTES=40,START=9,TYPE=C
         FIELD NAME=CITY,BYTES=25,START=49,TYPE=C
         FIELD NAME=STATE,BYTES=2,START=74,TYPE=C
         FIELD NAME=ZIP,BYTES=5,START=76,TYPE=C
*
         DBDGEN
         FINISH
         END
